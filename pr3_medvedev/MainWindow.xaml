<Window x:Class="pr3_medvedev.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr3_medvedev"
        mc:Ignorable="d"
        Title="HoPM_||PorPaMMa" Height="450" Width="800"
        Icon="/Resources/wisp-converted.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF76E383">
            <Image Width="52"
                   HorizontalAlignment="Left"
                   Margin="10,7,0,11"
                   Source="/Resources/broodwork1.png" Stretch="UniformToFill"/>
            <Button Name="btnBack"
                    HorizontalAlignment="Right"
                    Content="Назад"
                    Click="btnBack_Click"/>
        </Grid>


        <Frame x:Name="FrMain"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               ContentRendered="FrMain_ContentRendered"/>
    </Grid>
</Window>